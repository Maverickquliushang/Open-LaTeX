FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git python3 latexmk texlive-latex-extra texlive-xetex \
    texlive-lang-chinese texlive-fonts-recommended texlive-bibtex-extra \
    texlive-science biber poppler-utils \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["sleep", "infinity"]
